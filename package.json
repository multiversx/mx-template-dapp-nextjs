{
  "name": "mx-template-dapp-nextjs",
  "description": "MultiversX Next.js dApp Template",
  "version": "3.0.2",
  "author": "MultiversX",
  "license": "GPL-3.0-or-later",
  "repository": "@multiversx/mx-template-dapp-nextjs",
  "scripts": {
    "dev": "next dev --webpack --port 3002 | local-ssl-proxy --source 3000 --target 3002",
    "build": "pnpm build:devnet",
    "lint": "eslint .",
    "start": "pnpm copy-devnet-config && pnpm dev",
    "start:devnet": "pnpm copy-devnet-config && pnpm dev",
    "start:testnet": "pnpm copy-testnet-config && pnpm dev",
    "start:mainnet": "pnpm copy-mainnet-config && pnpm dev",
    "copy-devnet-config": "cp ./src/config/config.devnet.ts ./src/config/index.ts",
    "copy-testnet-config": "cp ./src/config/config.testnet.ts ./src/config/index.ts",
    "copy-mainnet-config": "cp ./src/config/config.mainnet.ts ./src/config/index.ts",
    "build:devnet": "pnpm copy-devnet-config && next build --webpack",
    "build:testnet": "pnpm copy-testnet-config && next build --webpack",
    "build:mainnet": "pnpm copy-mainnet-config && next build --webpack",
    "preview": "next start",
    "test": "jest",
    "run-playwright-test": "playwright test",
    "run-playwright-test-ui": "playwright test --ui"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-brands-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/react-fontawesome": "3.3.1",
    "@multiversx/sdk-core": "15.4.1",
    "@multiversx/sdk-dapp": "5.6.23",
    "@multiversx/sdk-dapp-ui": "0.1.24",
    "@multiversx/sdk-dapp-utils": "3.1.0",
    "@playwright/test": "^1.61.1",
    "axios": "1.18.1",
    "bignumber.js": "9.3.1",
    "classnames": "2.5.1",
    "moment": "2.30.1",
    "next": "16.2.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@svgr/webpack": "8.1.0",
    "@swc/core": "1.15.43",
    "@swc/jest": "0.2.39",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/react": "14.3.1",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.2",
    "bufferutil": "4.1.0",
    "cypress": "13.17.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "10.1.8",
    "fs-extra": "11.3.6",
    "jest": "29.7.0",
    "jest-fixed-jsdom": "0.0.11",
    "jest-watch-typeahead": "2.2.2",
    "local-ssl-proxy": "2.0.5",
    "mochawesome-merge": "4.4.1",
    "mochawesome-report-generator": "6.3.2",
    "postcss": "8.5.16",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "utf-8-validate": "6.0.6"
  }
}
